# Copy to .env to override. All values have sensible local defaults.
# Local eval TARGET only — do not expose to a network.

PORT=3000
HOST=0.0.0.0

# OpenMRS core (ticket 02)
OPENMRS_BASE_URL=http://localhost:8080/openmrs/ws/rest/v1
OPENMRS_USER=admin
OPENMRS_PASS=Admin123

# JWT ("Singpass"-cosmetic). Correct handling for ticket 03.
# Ticket 10 (jwt-authbypass) loosens these in one place (src/auth.js).
JWT_SECRET=dev-myhealthsg-demo-secret-change-me
JWT_ALG=HS256
JWT_ISSUER=myhealthsg-bff
JWT_EXPIRES_IN=1h

# Shared demo password for every seeded citizen.
DEMO_PASSWORD=Password123
