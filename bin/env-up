#!/usr/bin/env bash
# env-up — boot an emulator from a device-spec YAML and (ticket 04) provision it to t=0.
#
# Reads a validated device-spec (bin/_spec.sh), creates the AVD if needed (idempotent),
# cold-boots it from scratch on an explicit port, and returns only once the device is
# genuinely usable. Prints the adb serial `emulator-<console_port>` on stdout (and nothing
# else there, so callers can capture it); all progress goes to stderr.
#
# If a target APK is resolved (--target-apk / TARGET_APK=<path> / the env var / the spec's
# target_apk) and the spec's `provision` toggle is not false, the booted device is then
# provisioned (root shell, frida-server, APK installed, settings normalized — bin/_provision.sh)
# and verified before the serial is printed. With no target APK it bare-boots (ticket 03).
# Teardown is bin/env-down.
#
#   bin/env-up --spec devices/pixel-a37.yaml [--port 5554] [--target-apk <apk|dir>]
#   TARGET_APK=<apk> bin/env-up --spec devices/pixel-a37.yaml
#   bin/env-up --spec devices/rootbeer.yaml --window   # watch a real emulator on screen
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./env.sh
. "$HERE/env.sh"
# shellcheck source=./_spec.sh
. "$HERE/_spec.sh"
# shellcheck source=./_device.sh
. "$HERE/_device.sh"
# shellcheck source=./_provision.sh
. "$HERE/_provision.sh"

log() { printf 'env-up: %s\n' "$*" >&2; }
die() { printf 'env-up: %s\n' "$*" >&2; exit 1; }

usage() { echo "usage: env-up --spec <device-spec.yaml> [--port <console_port>] [--target-apk <apk|dir>] [--window|--no-window]" >&2; }

# TARGET_APK env var seeds the target; a --target-apk flag or a TARGET_APK=<path> token
# overrides it, and the spec's target_apk is the fallback (resolved after spec_load).
SPEC= PORT=5554 TARGET_APK_ARG=${TARGET_APK:-} HEADLESS_ARG=
BOOT_TIMEOUT=${ENV_UP_BOOT_TIMEOUT:-420}   # cold boot + wipe-data can take minutes
while [ $# -gt 0 ]; do
  case "$1" in
    --spec) SPEC=${2:-}; shift $(( $# > 1 ? 2 : 1 )) ;;
    --spec=*) SPEC=${1#--spec=}; shift ;;
    --port) PORT=${2:-}; shift $(( $# > 1 ? 2 : 1 )) ;;
    --port=*) PORT=${1#--port=}; shift ;;
    --target-apk) TARGET_APK_ARG=${2:-}; shift $(( $# > 1 ? 2 : 1 )) ;;
    --target-apk=*) TARGET_APK_ARG=${1#--target-apk=} ; shift ;;
    TARGET_APK=*) TARGET_APK_ARG=${1#TARGET_APK=} ; shift ;;   # literal ticket syntax
    --window|--headed)    HEADLESS_ARG=false; shift ;;   # show the emulator window
    --no-window|--headless) HEADLESS_ARG=true; shift ;;  # force headless (the default)
    -h|--help) usage; exit 0 ;;
    *) log "unknown argument: $1"; usage; exit 2 ;;
  esac
done

case "$PORT" in ''|*[!0-9]*) die "--port must be numeric, got '$PORT'";; esac
# The emulator console port must be even (adb takes the odd port+1), and adb only
# auto-discovers the 5554–5584 range — outside it the device never appears (RUNBOOK).
if [ $((PORT % 2)) -ne 0 ] || [ "$PORT" -lt 5554 ] || [ "$PORT" -gt 5584 ]; then
  die "--port must be an even console port in 5554–5584 (adb only discovers that range), got '$PORT'"
fi

# --- validate the spec (also confirms the system image is installed) ---------------------
spec_load "$SPEC" || exit $?

# --- tools present? give an actionable pointer instead of a raw command-not-found --------
for t in avdmanager emulator adb; do
  command -v "$t" >/dev/null 2>&1 || die "$t not on PATH — run 'source bin/env.sh' (see bin/doctor)"
done

SERIAL="emulator-$PORT"
AVD_HOME="${ANDROID_AVD_HOME:-$HOME/.android/avd}"
CFG="$AVD_HOME/${SPEC_NAME}.avd/config.ini"

# --- create the AVD (idempotent: reuse an existing one) ----------------------------------
if [ -f "$CFG" ]; then
  # Reuse keys on the AVD name, so guard against a stale AVD built from a DIFFERENT spec:
  # the target/API check below can't catch an image swap at the same API level, and a
  # mismatched profile would boot the wrong hardware. Refuse rather than silently boot it.
  want_sysdir="${SPEC_SYSTEM_IMAGE//;//}"; want_sysdir="${want_sysdir%/}"
  have_sysdir="$(cfg_get "$CFG" image.sysdir.1)"; have_sysdir="${have_sysdir%/}"
  have_dev="$(cfg_get "$CFG" hw.device.name)"
  if [ -n "$have_sysdir" ] && [ "$have_sysdir" != "$want_sysdir" ]; then
    die "AVD '$SPEC_NAME' already exists for a different system_image:
        have: $have_sysdir
        want: $want_sysdir
        tear it down first (reset = full rebuild): bin/env-down --spec $SPEC"
  fi
  if [ -n "$have_dev" ] && [ "$have_dev" != "$SPEC_DEVICE_PROFILE" ]; then
    die "AVD '$SPEC_NAME' already exists for a different device_profile (have '$have_dev',
        want '$SPEC_DEVICE_PROFILE') — bin/env-down --spec $SPEC first, then re-run env-up."
  fi
  log "AVD '$SPEC_NAME' already exists — reusing ($CFG)"
else
  log "creating AVD '$SPEC_NAME' from $SPEC_SYSTEM_IMAGE (device=$SPEC_DEVICE_PROFILE)"
  # `echo no` declines the "custom hardware profile?" prompt. cmdline-tools >= 23.0
  # (put on PATH by env.sh) writes target=android-<api>; the old 12.0 wrote android-0.
  # Route avdmanager's progress to stderr so stdout stays clean for the serial line.
  echo "no" | avdmanager create avd -n "$SPEC_NAME" -k "$SPEC_SYSTEM_IMAGE" -d "$SPEC_DEVICE_PROFILE" 1>&2 \
    || die "avdmanager create failed for '$SPEC_NAME'"
fi

# --- assert target=android-<api>: the api-0 black-screen guard (RUNBOOK / ticket 02) -----
TARGET="$(avd_target "$CFG")"
WANT="android-${SPEC_API}"
if [ "$TARGET" != "$WANT" ]; then
  die "AVD target is '${TARGET:-unset}', expected '$WANT' — an api-0 AVD boots to a black screen.
        This means the AVD was created by cmdline-tools < 23.0. Fix: source bin/env.sh (so the
        23.0 tools win), tear it down (bin/env-down --spec $SPEC), and re-run env-up."
fi
log "AVD target OK: $TARGET"

# --- apply the spec's hardware sizing to the AVD (single source of truth = the YAML) -----
cfg_set "$CFG" hw.ramSize             "$SPEC_RAM_MB"
cfg_set "$CFG" hw.cpu.ncore           "$SPEC_CORES"
cfg_set "$CFG" disk.dataPartition.size "${SPEC_DATA_SIZE_MB}M"

# --- kill any prior instance on this port BEFORE launching -------------------------------
# A second `emulator … -port 5554` launched over a live one lands on undiscoverable random
# ports (adb only scans 5554–5584) and looks stuck. Always clear the port first (RUNBOOK).
log "clearing any prior instance on $SERIAL"
emu_kill "$SERIAL" || die "an emulator on $SERIAL would not exit — kill it by hand and retry"

# --- cold boot from scratch, on the explicit port ----------------------------------------
# Headless by default (the harness/broker never needs a window); flip it with --window (or
# spec `headless: false`) to watch a real emulator on screen while testing. Resolve
# headless: an explicit --window/--no-window flag wins over the spec's headless toggle.
HEADLESS="$HEADLESS_ARG"
[ -n "$HEADLESS" ] || HEADLESS="${SPEC_HEADLESS:-true}"
if [ "$HEADLESS" = false ]; then WINDOW_FLAG=; MODE="windowed"; else WINDOW_FLAG="-no-window"; MODE="headless"; fi

LOG="$AVD_HOME/${SPEC_NAME}.avd/env-up-boot.log"
log "cold-booting '$SPEC_NAME' on port $PORT ($MODE, -wipe-data); log: $LOG"
# shellcheck disable=SC2086  # WINDOW_FLAG is empty (windowed) or a single flag; splitting is intended
nohup emulator -avd "$SPEC_NAME" $WINDOW_FLAG -no-snapshot-load -wipe-data \
      -port "$PORT" -no-audio -gpu swiftshader_indirect \
      >"$LOG" 2>&1 &
EMU_PID=$!
disown 2>/dev/null || true

# --- wait for genuine readiness (fail fast if the emulator process dies at launch) -------
log "waiting for boot (up to ${BOOT_TIMEOUT}s)…"
emu_wait_boot "$SERIAL" "$BOOT_TIMEOUT" "$EMU_PID"; wait_rc=$?
case "$wait_rc" in
  0) ;;
  2) die "the emulator process exited before $SERIAL booted — see $LOG" ;;
  *) die "device $SERIAL did not reach a ready state within ${BOOT_TIMEOUT}s — see $LOG" ;;
esac
log "device ready: $SERIAL"

# --- provision to t=0 (ticket 04) --------------------------------------------------------
# Resolve the target APK: an explicit --target-apk / TARGET_APK arg wins over the spec's
# target_apk. Path normalization (~/ expansion, relative→CWD→repo-root) is shared with
# bin/verify via apk_resolve_path so the two never disagree about a spec's target_apk.
TARGET_APK="$TARGET_APK_ARG"
[ -n "$TARGET_APK" ] || TARGET_APK="${SPEC_TARGET_APK:-}"
[ -n "$TARGET_APK" ] && TARGET_APK="$(apk_resolve_path "$TARGET_APK")"

if [ -z "$TARGET_APK" ]; then
  log "no target APK (--target-apk / TARGET_APK / spec target_apk) — bare boot, skipping provisioning"
elif [ "${SPEC_PROVISION:-true}" = false ]; then
  log "spec provision=false — bare boot, skipping provisioning (target APK '$TARGET_APK' not installed)"
else
  [ -e "$TARGET_APK" ] || die "target APK not found: $TARGET_APK"
  command -v frida-ps >/dev/null 2>&1 || die "frida-ps not on PATH — the provisioning verify needs the frida client (pip install frida-tools; see bin/doctor)"

  PKG="$(apk_package "$TARGET_APK")" || die "could not derive package from $TARGET_APK (is aapt on PATH? source bin/env.sh)"
  [ -n "$PKG" ] || die "derived an empty package name from $TARGET_APK — is it a valid APK?"
  ACT="$(apk_launch_activity "$TARGET_APK")"
  if apk_is_split "$TARGET_APK"; then KIND="split set"; else KIND="single apk"; fi
  log "provisioning $SERIAL for $PKG (launch: ${ACT:-<none>}) from $KIND"

  log "  root shell…";      prov_root "$SERIAL"    || die "provisioning failed: no root shell"
  if [ "${SPEC_FRIDA:-true}" = false ]; then
    log "  frida: skipped (spec frida=false)"
  else
    log "  frida-server…";  prov_frida "$SERIAL"   || die "provisioning failed: frida-server not reachable"
  fi
  log "  install APK…";     prov_install "$SERIAL" "$TARGET_APK" || die "provisioning failed: APK install"
  if [ "${SPEC_NORMALIZE_SETTINGS:-true}" = false ]; then
    log "  settings: skipped (spec normalize_settings=false)"
  else
    log "  normalize settings…"; prov_settings "$SERIAL" || die "provisioning failed: animation scales not zeroed"
  fi

  # Prove t=0 the same way bin/verify does (reachable + frida up + package present).
  if [ "${SPEC_FRIDA:-true}" != false ]; then
    verify_frida "$SERIAL" || die "post-provision check failed: frida client cannot reach $SERIAL"
  fi
  verify_package "$SERIAL" "$PKG" || die "post-provision check failed: $PKG not in pm list packages"
  log "provisioned + verified: $SERIAL ($PKG)"
fi

# The one line on stdout: the serial, for callers to capture.
printf '%s\n' "$SERIAL"
